{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vehiclerecon.local/schemas/vehicle_profile.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "const": "automobile"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optional_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_iou": {
      "type": "object",
      "properties": {
        "side": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "front": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rear": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "side",
        "top",
        "front",
        "rear"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "category",
    "roles",
    "optional_roles",
    "minimum_iou"
  ],
  "additionalProperties": false
}
