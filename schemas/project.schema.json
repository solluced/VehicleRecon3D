{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vehiclerecon.local/schemas/project.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "category": {
      "const": "automobile"
    },
    "vehicle_profile": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "asset_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "references": {
      "type": "object",
      "properties": {
        "multiview": {
          "type": "string",
          "minLength": 1
        },
        "control_overlay": {
          "type": "string",
          "minLength": 1
        },
        "surface_target": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "cage_overlay": {
          "type": "string",
          "minLength": 1
        },
        "front": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "minLength": 1
        },
        "rear": {
          "type": "string",
          "minLength": 1
        },
        "top": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "multiview",
        "control_overlay",
        "surface_target"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wheelbase_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "length_m",
        "width_m",
        "height_m",
        "wheelbase_m",
        "provenance"
      ],
      "additionalProperties": false
    },
    "generated": {
      "type": "object",
      "properties": {
        "calibration": {
          "type": "string",
          "minLength": 1
        },
        "cage": {
          "type": "string",
          "minLength": 1
        },
        "surface_graph": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "silhouette_traces": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "principled",
              "emission"
            ]
          },
          "color": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metallic": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "strength": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "kind",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "scene": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "world_color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "world_strength": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "name",
        "collections",
        "world_color",
        "world_strength"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object"
    },
    "export": {
      "type": "object"
    },
    "viewer": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "properties": {
        "thresholds": {
          "type": "object",
          "properties": {
            "side": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "top": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "front": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rear": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "side",
            "top",
            "front",
            "rear"
          ],
          "additionalProperties": false
        },
        "max_iou_regression": {
          "type": "number",
          "minimum": 0
        },
        "bounds_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "review_required": {
          "type": "boolean"
        },
        "baseline_iou": {
          "type": "object",
          "properties": {
            "side": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "top": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "front": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rear": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "side",
            "top",
            "front",
            "rear"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "thresholds",
        "max_iou_regression",
        "bounds_tolerance_m",
        "review_required",
        "baseline_iou"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "category",
    "vehicle_profile",
    "asset_name",
    "references",
    "dimensions",
    "generated",
    "materials",
    "scene",
    "presentation",
    "export",
    "viewer",
    "validation"
  ],
  "additionalProperties": false
}
