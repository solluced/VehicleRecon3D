{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vehiclerecon.local/schemas/review.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "geometry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proof_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "reviewer",
    "decision",
    "notes",
    "geometry_hash",
    "proof_hashes",
    "limitations",
    "input_state_hash"
  ],
  "additionalProperties": false
}
